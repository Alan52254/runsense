DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/runsense
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Required only for the competition demo login endpoints.
COMPETITION_DEMO_ONLY=true
DEMO_JWT_SECRET=replace-with-a-long-random-demo-secret

# Optional integrations.
OPENWEATHER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GARMIN_ACTIVITY_SYNC_ENABLED=false
# Optional hosted provider for citation-bounded Injury Guidance. The API key
# stays server-side; without it POST /injury-guidance returns a safe static
# fallback after deterministic triage.
# cloud first, the local model when the cloud is out of quota (comma = fallback order)
GUIDANCE_PROVIDER=groq,ollama
OLLAMA_COACH_MODEL=qwen2.5:7b
PLAN_RANKER_MODE=shadow_ml
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# AI workout analysis (History > AI 分析): models tried in order
WORKOUT_ANALYSIS_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
